erDiagram
    USUARIO ||--o{ GASTO : "registra / aprueba"
    USUARIO ||--o{ PAGO : "genera / aprueba / efectúa"
    PROVEEDOR ||--o{ GASTO : "factura"
    GASTO ||--o{ PAGO : "se liquida con"
    CUENTA_BANCARIA ||--o{ PAGO : "fondea"
    CUENTA_BANCARIA ||--o{ MOVIMIENTO_CUENTA : "registra"
    PAGO |o--o| MOVIMIENTO_CUENTA : "genera un cargo"
    GASTO ||--o{ BITACORA_ESTADO : "historial"
    PAGO ||--o{ BITACORA_ESTADO : "historial"

    USUARIO {
        int id PK
        varchar username UK
        varchar password "hash"
    }
    PROVEEDOR {
        int id PK
        varchar nombre UK
        varchar rfc
        varchar email
        varchar telefono
    }
    CUENTA_BANCARIA {
        int id PK
        varchar banco
        varchar nombre
        varchar numero UK
        varchar moneda
        decimal saldo_inicial
        decimal saldo "CHECK >= 0"
        bool activa
    }
    GASTO {
        int id PK
        varchar folio UK
        int proveedor_id FK
        varchar concepto
        varchar categoria
        decimal monto "CHECK > 0"
        date fecha
        date fecha_vencimiento
        varchar estado "PENDIENTE|APROBADO|PAGADO_PARCIAL|PAGADO|CANCELADO"
        int creado_por_id FK
        int aprobado_por_id FK
    }
    PAGO {
        int id PK
        varchar folio UK
        int gasto_id FK
        int cuenta_id FK
        decimal monto "CHECK > 0"
        varchar metodo
        varchar referencia
        varchar estado "PENDIENTE|APROBADO|EFECTUADO|CANCELADO"
        uuid idempotency_key UK
        datetime fecha_pago
        int creado_por_id FK
        int aprobado_por_id FK
        int efectuado_por_id FK
    }
    MOVIMIENTO_CUENTA {
        int id PK
        int cuenta_id FK
        int pago_id FK,UK "nullable"
        varchar tipo "CARGO|ABONO"
        decimal monto
        decimal saldo_resultante
        varchar descripcion
        datetime fecha
    }
    BITACORA_ESTADO {
        int id PK
        int gasto_id FK "nullable"
        int pago_id FK "nullable"
        varchar estado_anterior
        varchar estado_nuevo
        varchar comentario
        int usuario_id FK
        datetime fecha
    }
