flowchart TD
    CB((B)) --> D1{¿Aprobador decide<br/>sobre el pago?}
    D1 -- Cancelar --> X[Pago CANCELADO<br/>· no se reactiva ·<br/>el monto vuelve a estar disponible]
    X --> CA1((A))
    D1 -- Aprobar --> PA[/Pago APROBADO/]
    PA --> D2{¿Efectuar o<br/>cancelar?}
    D2 -- Cancelar --> X
    D2 -- Efectuar --> V1{¿Gasto sigue aprobado<br/>y el pago no se ha<br/>efectuado antes?}
    V1 -- No --> E1[Rechazo: gasto no aprobado<br/>o pago duplicado]
    V1 -- Sí --> V2{¿Monto ≤ saldo de<br/>la cuenta bancaria?}
    V2 -- No --> E2[Rechazo: saldo insuficiente<br/>· registrar abono o cancelar ·]
    E2 --> D2
    V2 -- Sí --> T[Transacción atómica:<br/>1 · descuenta el saldo de la cuenta<br/>2 · registra movimiento CARGO<br/>3 · pago EFECTUADO + fecha<br/>4 · bitácora]
    T --> V3{¿Total pagado =<br/>monto del gasto?}
    V3 -- No --> GP[/Gasto PAGADO PARCIAL/]
    GP --> CA2((A))
    V3 -- Sí --> GT[/Gasto PAGADO/]
    GT --> F([Fin])
    classDef err fill:#fef3c7,stroke:#f59e0b,color:#78350f
    classDef term fill:#fee2e2,stroke:#ef4444,color:#7f1d1d
    classDef ok fill:#dcfce7,stroke:#22c55e,color:#14532d
    classDef estado fill:#e0e7ff,stroke:#6366f1,color:#1e1b4b
    classDef conector fill:#4f46e5,stroke:#4f46e5,color:#fff
    class E1,E2 err
    class X term
    class T,GT ok
    class PA,GP estado
    class CB,CA1,CA2 conector
